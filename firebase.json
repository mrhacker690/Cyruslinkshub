{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "rewrites": [
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/register",
        "destination": "/register.html"
      },
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      },
      {
        "source": "/tools",
        "destination": "/tools.html"
      },
      {
        "source": "/games",
        "destination": "/games.html"
      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/forgot-password",
        "destination": "/forgot-password.html"
      }
    ]
  }
}
